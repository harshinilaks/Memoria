# Database connection (SQLAlchemy URL using the psycopg 3 driver).
# These values match docker-compose.yml and are for local development only.
DATABASE_URL=postgresql+psycopg://memoria:memoria_password@localhost:5432/memoria

# Separate database used by the integration test suite. It is wiped between tests.
TEST_DATABASE_URL=postgresql+psycopg://memoria:memoria_password@localhost:5432/memoria_test

# Development identity: every request is scoped to this namespace.
# This is NOT a security boundary - real authentication/authorization is required
# before exposing the service to untrusted clients.
DEV_NAMESPACE=development

# Logging
LOG_LEVEL=INFO
