# Database connection (SQLAlchemy URL using the psycopg 3 driver).
# These values match docker-compose.yml and are for local development only.
DATABASE_URL=postgresql+psycopg://memoria:memoria_password@localhost:5432/memoria

# Separate database used by the integration test suite. It is wiped between tests.
TEST_DATABASE_URL=postgresql+psycopg://memoria:memoria_password@localhost:5432/memoria_test

# Development identity: every request is scoped to this namespace.
# This is NOT a security boundary - real authentication/authorization is required
# before exposing the service to untrusted clients.
DEV_NAMESPACE=development

# Embeddings. "fastembed" runs a local ONNX model (downloaded on first use);
# "hash" is a deterministic, non-semantic embedder for tests/offline use.
# The model must produce 384-dimensional vectors (the database column size).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=.cache/fastembed

# Lifecycle (cosine similarity thresholds, tuned for bge-small-en-v1.5).
# Writes at or above DEDUP are merged into the existing memory; similar memories at or
# above CONFLICT are checked for contradictions.
# DEDUP_SIMILARITY_THRESHOLD=0.92
# CONFLICT_SIMILARITY_THRESHOLD=0.80

# Search ranking: score = weighted blend of similarity, recency and importance.
# RANKING_SIMILARITY_WEIGHT=0.70
# RANKING_RECENCY_WEIGHT=0.15
# RANKING_IMPORTANCE_WEIGHT=0.15
# RECENCY_HALF_LIFE_DAYS=30
# REINFORCEMENT_IMPORTANCE_BOOST=0.05

# Logging
LOG_LEVEL=INFO
